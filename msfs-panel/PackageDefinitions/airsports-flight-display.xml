<?xml version="1.0" encoding="utf-8"?>
<AssetPackage Version="1.0.0">
	<ItemSettings>
		<ContentType>MISC</ContentType>
		<Title>Airsports flight display</Title>
		<Manufacturer/>
		<Creator>Air Sports Live Tracking</Creator>
	</ItemSettings>
	<Flags>
		<VisibleInStore>false</VisibleInStore>
		<CanBeReferenced>false</CanBeReferenced>
	</Flags>
	<AssetGroups>
		<AssetGroup Name="ContentInfo">
			<Type>ContentInfo</Type>
			<Flags>
				<FSXCompatibility>false</FSXCompatibility>
			</Flags>
			<AssetDir>PackageDefinitions\airsports-flight-display\ContentInfo\</AssetDir>
			<OutputDir>ContentInfo\airsports-flight-display\</OutputDir>
		</AssetGroup>
		<!-- The panel page, its script and fonts (hud.js and hud.css are copied in from msfsclient.Core/Hud by build-panel.ps1). -->
		<AssetGroup Name="html_ui">
			<Type>Copy</Type>
			<Flags>
				<FSXCompatibility>false</FSXCompatibility>
			</Flags>
			<AssetDir>PackageSources\html_ui\</AssetDir>
			<OutputDir>html_ui\</OutputDir>
		</AssetGroup>
		<!-- The toolbar entry: compiled to InGamePanels\InGamePanel_Airsports.spb. -->
		<AssetGroup Name="InGamePanels">
			<Type>SPB</Type>
			<Flags>
				<FSXCompatibility>false</FSXCompatibility>
			</Flags>
			<AssetDir>PackageSources\InGamePanels\</AssetDir>
			<OutputDir>InGamePanels\</OutputDir>
		</AssetGroup>
	</AssetGroups>
</AssetPackage>
