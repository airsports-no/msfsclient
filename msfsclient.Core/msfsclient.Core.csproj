<Project Sdk="Microsoft.NET.Sdk">
  <!-- Everything that is not UI or SimConnect: API client, models, app state machine, tracking, queues, GPX and rules.
       Builds and tests on any OS (no WinUI or Windows references), so CI can run the tests on Linux. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>msfsclient.Core</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="msfsclient.Core.Tests" />
  </ItemGroup>
</Project>
