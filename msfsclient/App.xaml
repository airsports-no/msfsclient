<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="msfsclient.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:msfsclient"
    xmlns:conv="using:msfsclient.Helpers.Converters"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <conv:StringVisibilityConverter x:Key="StringVisibilityConverter" />
            <conv:InverseBoolConverter x:Key="InverseBoolConverter" />
            <conv:UrlToImageSourceConverter x:Key="UrlToImageSourceConverter" />

            <Style TargetType="TextBlock" x:Key="CaptionTextBlockStyle">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Opacity" Value="0.6"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>

