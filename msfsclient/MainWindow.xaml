<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="msfsclient.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:msfsclient.Views"
    xmlns:helpers="using:msfsclient.Helpers"
    Title="Airsports">

    <Grid x:Name="Root" Background="{ThemeResource PaperBrush}" KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="Back_Invoked" />
            <KeyboardAccelerator Key="Left" Modifiers="Menu" Invoked="Back_Invoked" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Plain ink header with the logo; it is also the window's title bar. Back on every screen that has somewhere to go back to. -->
        <Grid x:Name="TitleBar" RequestedTheme="Dark" Background="{ThemeResource InkBrush}" Height="56" Padding="12,0,140,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="BackButton" Click="Back_Click" Visibility="{x:Bind Vm.ShowBack, Mode=OneWay}"
                    Background="Transparent" BorderThickness="0" Padding="6,4" Foreground="{StaticResource HeaderContentBrush}"
                    AutomationProperties.Name="Back" ToolTipService.ToolTip="Back (Esc)">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE72B;" FontSize="16" />
                    <TextBlock Text="Back" FontFamily="{StaticResource BarlowSemiBold}" FontSize="16" />
                </StackPanel>
            </Button>
            <Image Grid.Column="1" Source="ms-appx:///Assets/airsports_logo_white.png" Height="26" Stretch="Uniform"
                   AutomationProperties.Name="Air Sports" />
            <Button x:Name="AvatarButton" Grid.Column="3" Click="Avatar_Click" Visibility="{x:Bind Vm.ShowAvatar, Mode=OneWay}"
                    Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="18"
                    AutomationProperties.Name="Profile" ToolTipService.ToolTip="Profile">
                <PersonPicture Width="36" Height="36" Initials="{x:Bind Vm.Initials, Mode=OneWay}"
                               ProfilePicture="{x:Bind helpers:Ui.Image(Vm.PictureUrl), Mode=OneWay}" />
            </Button>
        </Grid>

        <!-- A desktop window is wide: the mobile single column, centred, at most about 520 px. -->
        <ContentControl x:Name="Page" Grid.Row="1" MaxWidth="560" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" IsTabStop="False" />

        <views:FlightDeck x:Name="Deck" Grid.Row="2" MaxWidth="560" Visibility="{x:Bind Vm.ShowDock, Mode=OneWay}" />
    </Grid>
</Window>
