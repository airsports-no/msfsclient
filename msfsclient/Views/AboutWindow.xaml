<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="msfsclient.Views.AboutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:msfsclient.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="About AirSports Live Tracking">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="30">
        <ScrollViewer>
            <StackPanel Spacing="15">
                <TextBlock Text="About AirSports Live Tracking" Style="{StaticResource TitleTextBlockStyle}"/>
                
                <StackPanel Spacing="5">
                    <TextBlock Text="AirSports MSFS Connector" Style="{StaticResource SubtitleTextBlockStyle}" Foreground="{ThemeResource SystemAccentColorLight2}"/>
                    <TextBlock Text="Bridging Simulation and Reality" Style="{StaticResource BodyTextBlockStyle}" FontStyle="Italic" Opacity="0.8"/>
                </StackPanel>

                <TextBlock Text="Overview" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,10,0,0"/>
                <TextBlock Text="Welcome to AirSports! This client connects your Microsoft Flight Simulator experience directly to the world’s leading open-source platform for competitive and leisure general aviation tracking." 
                           TextWrapping="Wrap" Style="{StaticResource BodyTextBlockStyle}"/>
                
                <TextBlock Text="AirSports Live Tracking is dedicated to modernizing air sports through real-time technology. Whether you are participating in a high-stakes Air Navigation Race (ANR), a local Poker Run, or simply sharing your scenic simulation flights with a global community, our platform provides the precision scoring and telemetry you need." 
                           TextWrapping="Wrap" Style="{StaticResource BodyTextBlockStyle}"/>

                <TextBlock Text="Useful Links" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,10,0,0"/>
                <StackPanel Spacing="5">
                    <HyperlinkButton Content="Official Website: airsports.no" NavigateUri="https://airsports.no" Padding="0"/>
                    <HyperlinkButton Content="Live Tracking Dashboard: app.airsports.no" NavigateUri="https://app.airsports.no" Padding="0"/>
                </StackPanel>

                <TextBlock Text="Documentation &amp; Support" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,10,0,0"/>
                <TextBlock Text="New to the platform? Check out our comprehensive guides to get the most out of your flight:" 
                           TextWrapping="Wrap" Style="{StaticResource BodyTextBlockStyle}"/>
                <StackPanel Spacing="5">
                    <HyperlinkButton Content="Contestant Guide" NavigateUri="https://airsports.no/docs/02_Contestant_Guide" Padding="0"/>
                    <HyperlinkButton Content="Contest Manager Guide" NavigateUri="https://airsports.no/docs/03_Contest_Manager_Guide" Padding="0"/>
                </StackPanel>

                <TextBlock Text="Legal" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,10,0,0"/>
                <TextBlock Text="Your privacy and safety are important to us. By using this application, you agree to our:" 
                           TextWrapping="Wrap" Style="{StaticResource BodyTextBlockStyle}"/>
                <HyperlinkButton Content="Terms and Conditions" NavigateUri="https://airsports.no/terms_and_conditions" Padding="0"/>

                <MenuFlyoutSeparator Margin="0,10"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="Version Information" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        <TextBlock x:Name="VersionText" Text="Client Version: 1.0.0" Style="{StaticResource CaptionTextBlockStyle}"/>
                        <TextBlock Text="Status: Connected" Style="{StaticResource CaptionTextBlockStyle}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="Built with passion by the AirSports community. We fly together!" 
                               Style="{StaticResource CaptionTextBlockStyle}" 
                               VerticalAlignment="Bottom" 
                               HorizontalAlignment="Right"
                               Opacity="0.7"
                               Width="200"
                               TextAlignment="Right"
                               TextWrapping="Wrap"/>
                </Grid>
                
                <Button Content="Close" Click="Close_Click" HorizontalAlignment="Right" Margin="0,20,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
