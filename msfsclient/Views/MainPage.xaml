<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="msfsclient.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:msfsclient.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Button x:Name="ProfileButton" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Padding="0">
            <StackPanel Orientation="Horizontal" Spacing="20">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="5">
                        <Image Source="{x:Bind ViewModel.Profile.CountryFlagUrl, Mode=OneWay, Converter={StaticResource UrlToImageSourceConverter}}" 
                               Width="16" Height="12" VerticalAlignment="Center" Stretch="UniformToFill"/>
                        <TextBlock Text="{x:Bind ViewModel.Profile.FullName, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.Profile.Email, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"/>
                </StackPanel>
                <PersonPicture ProfilePicture="{x:Bind ViewModel.Profile.ProfilePictureUrl, Mode=OneWay, Converter={StaticResource UrlToImageSourceConverter}}" 
                               DisplayName="{x:Bind ViewModel.Profile.FullName, Mode=OneWay}"
                               Height="40" Width="40"/>
            </StackPanel>
            
            <Button.Flyout>
                <Flyout>
                    <Grid MinWidth="250" MaxWidth="300">
                        <!-- View Mode -->
                        <StackPanel Spacing="15" HorizontalAlignment="Center" 
                                    Visibility="{x:Bind ViewModel.IsEditingProfile, Mode=OneWay, Converter={StaticResource NegatedBoolToVisibilityConverter}}">
                            <PersonPicture ProfilePicture="{x:Bind ViewModel.Profile.ProfilePictureUrl, Mode=OneWay, Converter={StaticResource UrlToImageSourceConverter}}" 
                                           DisplayName="{x:Bind ViewModel.Profile.FullName, Mode=OneWay}"
                                           Height="100" Width="100"/>
                            <StackPanel Spacing="2">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="5">
                                    <Image Source="{x:Bind ViewModel.Profile.CountryFlagUrl, Mode=OneWay, Converter={StaticResource UrlToImageSourceConverter}}" 
                                           Width="20" Height="15" VerticalAlignment="Center" Stretch="UniformToFill"/>
                                    <TextBlock Text="{x:Bind ViewModel.Profile.FullName, Mode=OneWay}" 
                                               Style="{StaticResource SubtitleTextBlockStyle}" 
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.Profile.Email, Mode=OneWay}" 
                                           Style="{StaticResource CaptionTextBlockStyle}" 
                                           HorizontalAlignment="Center" 
                                           Opacity="0.7"/>
                            </StackPanel>

                            <TextBlock Text="{x:Bind ViewModel.Profile.Biography, Mode=OneWay}" 
                                       Style="{StaticResource BodyTextBlockStyle}" 
                                       TextWrapping="Wrap" 
                                       HorizontalAlignment="Center"
                                       Visibility="{x:Bind ViewModel.Profile.Biography, Mode=OneWay, Converter={StaticResource StringVisibilityConverter}}"/>
                            
                            <MenuFlyoutSeparator/>
                            
                            <Button Content="Edit Profile" 
                                    Command="{x:Bind ViewModel.StartEditProfileCommand}"
                                    HorizontalAlignment="Stretch"/>

                            <Button Content="Logout" 
                                    Command="{x:Bind ViewModel.LogoutCommand}" 
                                    HorizontalAlignment="Stretch"
                                    Style="{StaticResource AccentButtonStyle}"/>

                            <MenuFlyoutSeparator/>
                            
                            <ToggleSwitch Header="Debug: Show Flight Logs" 
                                          IsOn="{x:Bind ViewModel.ShowFlightLogs, Mode=TwoWay}"
                                          FontSize="12"/>
                        </StackPanel>

                        <!-- Edit Mode -->
                        <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.IsEditingProfile, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="Edit Profile" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            
                            <TextBox Header="First Name" Text="{x:Bind ViewModel.EditFirstName, Mode=TwoWay}"/>
                            <TextBox Header="Last Name" Text="{x:Bind ViewModel.EditLastName, Mode=TwoWay}"/>
                            
                            <StackPanel Spacing="5">
                                <TextBlock Text="Profile Picture" Style="{StaticResource BodyTextBlockStyle}"/>
                                <Button Content="Choose Image..." Click="SelectProfileImage_Click" HorizontalAlignment="Stretch"/>
                                <TextBlock Text="{x:Bind ViewModel.PendingProfileImageFileName, Mode=OneWay}" 
                                           Style="{StaticResource CaptionTextBlockStyle}" 
                                           Visibility="{x:Bind ViewModel.PendingProfileImageFileName, Mode=OneWay, Converter={StaticResource StringVisibilityConverter}}"
                                           FontStyle="Italic"/>
                            </StackPanel>

                            <TextBox Header="Biography" Text="{x:Bind ViewModel.EditBiography, Mode=TwoWay}" 
                                     AcceptsReturn="True" Height="80" TextWrapping="Wrap"/>

                            <TextBlock Text="{x:Bind ViewModel.ProfileErrorMessage, Mode=OneWay}" 
                                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Visibility="{x:Bind ViewModel.ProfileErrorMessage, Mode=OneWay, Converter={StaticResource StringVisibilityConverter}}"/>

                            <TextBlock Text="{x:Bind ViewModel.ProfileStatusMessage, Mode=OneWay}" 
                                       Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Visibility="{x:Bind ViewModel.ProfileStatusMessage, Mode=OneWay, Converter={StaticResource StringVisibilityConverter}}"/>

                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="Save" 
                                        Command="{x:Bind ViewModel.SaveProfileCommand}"
                                        HorizontalAlignment="Stretch"
                                        Style="{StaticResource AccentButtonStyle}"/>
                                <Button Grid.Column="1" Content="Cancel" 
                                        Command="{x:Bind ViewModel.CancelEditProfileCommand}"
                                        HorizontalAlignment="Stretch"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Flyout>
            </Button.Flyout>
        </Button>
    </Grid>

        <Grid Grid.Row="1" Margin="0,20,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Status and Tracking Area -->
            <StackPanel Grid.Row="0" Spacing="10" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Border Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}" 
                            CornerRadius="4" 
                            Padding="12,8">
                        <StackPanel Orientation="Horizontal" Spacing="15">
                            <!-- SimConnect Status -->
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Ellipse Width="12" Height="12" 
                                         Fill="{x:Bind ViewModel.IsSimConnected, Mode=OneWay, Converter={StaticResource ConnectionStatusToColorConverter}}"/>
                                <TextBlock Text="SimConnect" 
                                           Style="{StaticResource BodyTextBlockStyle}"
                                           VerticalAlignment="Center"/>
                                <!-- SimConnect Pulse Indicator -->
                                <Ellipse Width="8" Height="8" 
                                         VerticalAlignment="Center"
                                         Fill="{x:Bind ViewModel.LastSimConnectUpdateSuccessful, Mode=OneWay, Converter={StaticResource ConnectionStatusToColorConverter}}"
                                         Opacity="{x:Bind ViewModel.IsSimConnectPulseActive, Mode=OneWay, Converter={StaticResource BoolToOpacityConverter}}">
                                    <ToolTipService.ToolTip>
                                        <ToolTip Content="{x:Bind ViewModel.LastSimConnectUpdateTime, Mode=OneWay, Converter={StaticResource StringFormatConverter}, ConverterParameter='Last Updated: {0}'}"/>
                                    </ToolTipService.ToolTip>
                                </Ellipse>
                            </StackPanel>

                            <MenuFlyoutSeparator Opacity="0.2"/>

                            <!-- Traccar Status -->
                            <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind ViewModel.IsTracking, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="Traccar" 
                                           Style="{StaticResource BodyTextBlockStyle}"
                                           VerticalAlignment="Center"/>
                                <!-- Traccar Pulse Indicator -->
                                <Ellipse Width="8" Height="8" 
                                         VerticalAlignment="Center"
                                         Fill="{x:Bind ViewModel.LastTraccarUpdateSuccessful, Mode=OneWay, Converter={StaticResource ConnectionStatusToColorConverter}}"
                                         Opacity="{x:Bind ViewModel.IsTraccarPulseActive, Mode=OneWay, Converter={StaticResource BoolToOpacityConverter}}">
                                    <ToolTipService.ToolTip>
                                        <ToolTip Content="{x:Bind ViewModel.LastTraccarUpdateTime, Mode=OneWay, Converter={StaticResource StringFormatConverter}, ConverterParameter='Last Updated: {0}'}"/>
                                    </ToolTipService.ToolTip>
                                </Ellipse>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Button Click="StartStopTracking_Click" 
                            Style="{StaticResource AccentButtonStyle}"
                            Padding="15,8">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="{x:Bind ViewModel.IsTracking, Mode=OneWay, Converter={StaticResource TrackingToIconConverter}}" FontSize="16"/>
                            <TextBlock Text="{x:Bind ViewModel.IsTracking, Mode=OneWay, Converter={StaticResource TrackingToTextConverter}}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Error Messages -->
                <StackPanel Spacing="5" Margin="5,0,0,0">
                    <TextBlock Text="{x:Bind ViewModel.SimConnectErrorMessage, Mode=OneWay}" 
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Visibility="{x:Bind ViewModel.SimConnectErrorMessage, Mode=OneWay, Converter={StaticResource StringVisibilityConverter}}"/>
                    
                    <TextBlock Text="{x:Bind ViewModel.TraccarErrorMessage, Mode=OneWay}" 
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Visibility="{x:Bind ViewModel.TraccarErrorMessage, Mode=OneWay, Converter={StaticResource StringVisibilityConverter}}"/>
                </StackPanel>


                <!-- Navigation Task Section -->
                <Border Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}" 
                        CornerRadius="4" Padding="12" Margin="0,5,0,0">
                    <StackPanel Spacing="5">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                            <TextBlock Text="Current Task:" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7"/>
                            <HyperlinkButton Content="{x:Bind ViewModel.CurrentNavigationTask.Name, Mode=OneWay}" 
                                             Command="{x:Bind ViewModel.LoadNavigationTaskCommand}"
                                             Margin="5,-2,0,0"
                                             Padding="0"
                                             Visibility="{x:Bind ViewModel.CurrentNavigationTask, Mode=OneWay, Converter={StaticResource NotNullToVisibilityConverter}}"/>
                            <TextBlock Text="None" 
                                       Style="{StaticResource BodyTextBlockStyle}" 
                                       Margin="5,0,0,0"
                                       Visibility="{x:Bind ViewModel.CurrentNavigationTask, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}"/>
                        </StackPanel>
                        
                        <StackPanel Visibility="{x:Bind ViewModel.CurrentNavigationTask, Mode=OneWay, Converter={StaticResource NotNullToVisibilityConverter}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Start" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.5"/>
                                    <TextBlock Text="{x:Bind ViewModel.CurrentNavigationTask.StartTime, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Finish" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.5"/>
                                    <TextBlock Text="{x:Bind ViewModel.CurrentNavigationTask.FinishTime, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"/>
                                </StackPanel>
                            </Grid>

                            <HyperlinkButton Content="View Tracking Link" 
                                             Command="{x:Bind ViewModel.OpenTrackingLinkCommand}"
                                             Padding="0" Margin="0,5,0,0"
                                             Visibility="{x:Bind ViewModel.CurrentNavigationTask.TrackingLink, Mode=OneWay, Converter={StaticResource StringVisibilityConverter}}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Dashboard -->
            <Grid Grid.Row="1" ColumnSpacing="20" RowSpacing="10" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Column="0" Grid.Row="0">
                    <TextBlock Text="Latitude" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7"/>
                    <TextBlock Text="{x:Bind ViewModel.CurrentFlightData.Latitude, Mode=OneWay, Converter={StaticResource DoubleFormatConverter}, ConverterParameter='F4'}" Style="{StaticResource SubtitleTextBlockStyle}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Grid.Row="0">
                    <TextBlock Text="Longitude" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7"/>
                    <TextBlock Text="{x:Bind ViewModel.CurrentFlightData.Longitude, Mode=OneWay, Converter={StaticResource DoubleFormatConverter}, ConverterParameter='F4'}" Style="{StaticResource SubtitleTextBlockStyle}"/>
                </StackPanel>

                <StackPanel Grid.Column="0" Grid.Row="1">
                    <TextBlock Text="Altitude (ft)" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7"/>
                    <TextBlock Text="{x:Bind ViewModel.CurrentFlightData.Altitude, Mode=OneWay, Converter={StaticResource DoubleFormatConverter}, ConverterParameter='F0'}" Style="{StaticResource SubtitleTextBlockStyle}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Grid.Row="1">
                    <TextBlock Text="Ground Speed (kt)" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7"/>
                    <TextBlock Text="{x:Bind ViewModel.CurrentFlightData.GroundVelocity, Mode=OneWay, Converter={StaticResource DoubleFormatConverter}, ConverterParameter='F1'}" Style="{StaticResource SubtitleTextBlockStyle}"/>
                </StackPanel>

                <StackPanel Grid.Column="0" Grid.Row="2">
                    <TextBlock Text="Heading" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7"/>
                    <TextBlock Text="{x:Bind ViewModel.CurrentFlightData.HeadingDegrees, Mode=OneWay, Converter={StaticResource DoubleFormatConverter}, ConverterParameter='F1'}" Style="{StaticResource SubtitleTextBlockStyle}"/>
                </StackPanel>
            </Grid>

            <!-- Logs -->
            <Grid Grid.Row="2" Visibility="{x:Bind ViewModel.ShowFlightLogs, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Flight Logs" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,0,0,5"/>
                <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.FlightLogs}" BorderThickness="1" BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{Binding}" Style="{StaticResource CaptionTextBlockStyle}" FontFamily="Consolas"/>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
            
            <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Grid>

        <Image Grid.Row="2" Source="/Assets/airsports.png" HorizontalAlignment="Center" Height="40" Margin="0,10,0,0" Stretch="Uniform"/>
    </Grid>
</Page>
