<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="msfsclient.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:msfsclient.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Button HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Padding="0">
            <StackPanel Orientation="Horizontal" Spacing="20">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="{x:Bind ViewModel.Profile.FullName, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                    <TextBlock Text="{x:Bind ViewModel.Profile.Email, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"/>
                </StackPanel>
                <PersonPicture ProfilePicture="{x:Bind ViewModel.Profile.ProfilePictureUrl, Mode=OneWay, Converter={StaticResource UrlToImageSourceConverter}}" 
                               DisplayName="{x:Bind ViewModel.Profile.FullName, Mode=OneWay}"
                               Height="40" Width="40"/>
            </StackPanel>
            
            <Button.Flyout>
                <Flyout>
                    <StackPanel Spacing="15" MinWidth="200" HorizontalAlignment="Center">
                        <PersonPicture ProfilePicture="{x:Bind ViewModel.Profile.ProfilePictureUrl, Mode=OneWay, Converter={StaticResource UrlToImageSourceConverter}}" 
                                       DisplayName="{x:Bind ViewModel.Profile.FullName, Mode=OneWay}"
                                       Height="100" Width="100"/>
                        <TextBlock Text="{x:Bind ViewModel.Profile.FullName, Mode=OneWay}" 
                                   Style="{StaticResource SubtitleTextBlockStyle}" 
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{x:Bind ViewModel.Profile.Email, Mode=OneWay}" 
                                   Style="{StaticResource CaptionTextBlockStyle}" 
                                   HorizontalAlignment="Center" 
                                   Opacity="0.7"/>
                        
                        <MenuFlyoutSeparator/>
                        
                        <Button Content="Logout" 
                                Command="{x:Bind ViewModel.LogoutCommand}" 
                                HorizontalAlignment="Stretch"
                                Style="{StaticResource AccentButtonStyle}"/>
                    </StackPanel>
                </Flyout>
            </Button.Flyout>
        </Button>

        <Grid Grid.Row="1" Margin="0,20,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Connection Status & Tracking -->
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,20">
                <Border Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}" 
                        CornerRadius="4" 
                        Padding="12,8">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Ellipse Width="12" Height="12" Fill="{x:Bind ViewModel.IsSimConnected, Mode=OneWay, Converter={StaticResource ConnectionStatusToColorConverter}}"/>
                        <TextBlock Text="{x:Bind ViewModel.IsSimConnected, Mode=OneWay, Converter={StaticResource ConnectionStatusToTextConverter}}" 
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Button Command="{x:Bind ViewModel.ToggleTrackingCommand, Mode=OneWay}" 
                        Style="{StaticResource AccentButtonStyle}"
                        Padding="15,8">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="{x:Bind ViewModel.IsTracking, Mode=OneWay, Converter={StaticResource TrackingToIconConverter}}" FontSize="16"/>
                        <TextBlock Text="{x:Bind ViewModel.IsTracking, Mode=OneWay, Converter={StaticResource TrackingToTextConverter}}"/>
                    </StackPanel>
                </Button>

                <!-- Traccar Pulse Indicator -->
                <Ellipse Width="12" Height="12" 
                         VerticalAlignment="Center"
                         Fill="{x:Bind ViewModel.LastTraccarUpdateSuccessful, Mode=OneWay, Converter={StaticResource ConnectionStatusToColorConverter}}"
                         Opacity="{x:Bind ViewModel.IsTraccarPulseActive, Mode=OneWay, Converter={StaticResource BoolToOpacityConverter}}"
                         Visibility="{x:Bind ViewModel.IsTracking, Mode=OneWay, Converter={StaticResource StringVisibilityConverter}}">
                    <ToolTipService.ToolTip>
                        <ToolTip Content="Traccar Transmission Status"/>
                    </ToolTipService.ToolTip>
                </Ellipse>
            </StackPanel>

            <TextBlock Text="{x:Bind ViewModel.Profile.SimulatorTrackingId, Mode=OneWay, Converter={StaticResource StringFormatConverter}, ConverterParameter='Tracking ID: {0}'}" 
                       Style="{StaticResource CaptionTextBlockStyle}" 
                       Margin="0,-15,0,20"
                       Visibility="{x:Bind ViewModel.Profile.SimulatorTrackingId, Mode=OneWay, Converter={StaticResource StringVisibilityConverter}}"/>

            <!-- Dashboard -->
            <Grid Grid.Row="1" ColumnSpacing="20" RowSpacing="10" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Column="0" Grid.Row="0">
                    <TextBlock Text="Latitude" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7"/>
                    <TextBlock Text="{x:Bind ViewModel.CurrentFlightData.Latitude, Mode=OneWay, Converter={StaticResource DoubleFormatConverter}, ConverterParameter='F4'}" Style="{StaticResource SubtitleTextBlockStyle}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Grid.Row="0">
                    <TextBlock Text="Longitude" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7"/>
                    <TextBlock Text="{x:Bind ViewModel.CurrentFlightData.Longitude, Mode=OneWay, Converter={StaticResource DoubleFormatConverter}, ConverterParameter='F4'}" Style="{StaticResource SubtitleTextBlockStyle}"/>
                </StackPanel>

                <StackPanel Grid.Column="0" Grid.Row="1">
                    <TextBlock Text="Altitude (ft)" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7"/>
                    <TextBlock Text="{x:Bind ViewModel.CurrentFlightData.Altitude, Mode=OneWay, Converter={StaticResource DoubleFormatConverter}, ConverterParameter='F0'}" Style="{StaticResource SubtitleTextBlockStyle}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Grid.Row="1">
                    <TextBlock Text="Ground Speed (kt)" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7"/>
                    <TextBlock Text="{x:Bind ViewModel.CurrentFlightData.GroundVelocity, Mode=OneWay, Converter={StaticResource DoubleFormatConverter}, ConverterParameter='F1'}" Style="{StaticResource SubtitleTextBlockStyle}"/>
                </StackPanel>

                <StackPanel Grid.Column="0" Grid.Row="2">
                    <TextBlock Text="Heading" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7"/>
                    <TextBlock Text="{x:Bind ViewModel.CurrentFlightData.HeadingDegrees, Mode=OneWay, Converter={StaticResource DoubleFormatConverter}, ConverterParameter='F1'}" Style="{StaticResource SubtitleTextBlockStyle}"/>
                </StackPanel>
            </Grid>

            <!-- Logs -->
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Flight Logs" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,0,0,5"/>
                <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.FlightLogs}" BorderThickness="1" BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{Binding}" Style="{StaticResource CaptionTextBlockStyle}" FontFamily="Consolas"/>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
            
            <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Grid>
    </Grid>
</Page>
