<?xml version="1.0" encoding="utf-8"?>
<!--
    The Timer page (port of TimerScreen): the adaptive-start timer and, in training mode, the countdown to the next gate's
    required time. With both, the chosen one is large and the other small above it. The page scrolls on a small window;
    START stays pinned at the bottom.
-->
<local:ShellPart
    x:Class="msfsclient.Views.TimerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:msfsclient.Views"
    FontFamily="{StaticResource BarlowRegular}">
    <Grid Padding="16,8" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer>
            <StackPanel Spacing="4" HorizontalAlignment="Stretch">
                <HyperlinkButton x:Name="ResetButton" Content="Reset" HorizontalAlignment="Right" Style="{StaticResource TextButton}" Click="Reset_Click" />

                <!-- The PC clock against network time: positions are stamped with the PC clock. -->
                <TextBlock x:Name="ClockOk" Style="{StaticResource BodyText}" />
                <Border x:Name="ClockDrift" Background="{ThemeResource ErrorContainerBrush}" CornerRadius="10" Padding="12" Visibility="Collapsed">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="DriftTitle" Style="{StaticResource StrongText}" Foreground="{ThemeResource OnErrorContainerBrush}" />
                        <TextBlock x:Name="DriftText" Style="{StaticResource BodyText}" Foreground="{ThemeResource OnErrorContainerBrush}" />
                        <HyperlinkButton Content="Open date and time settings" Style="{StaticResource TextButton}" Click="ClockSettings_Click" />
                    </StackPanel>
                </Border>

                <!-- The other timer, small, as a reference; clicking it makes it the large one. -->
                <Button x:Name="SmallTimer" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="12,8" Margin="0,8,0,0"
                        Click="SmallTimer_Click" Visibility="Collapsed" AutomationProperties.Name="Show this timer large">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="SmallLabel" Style="{StaticResource StrongText}" />
                            <TextBlock x:Name="SmallValue" FontFamily="{StaticResource CondensedBold}" FontSize="36" Foreground="{ThemeResource TextBrush}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="Click to show large" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                    </Grid>
                </Button>

                <!-- The countdown to the next gate's required time, large. -->
                <StackPanel x:Name="GateLarge" Spacing="4" HorizontalAlignment="Center" Margin="0,24,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="GateName" Style="{StaticResource CondensedTitle}" HorizontalAlignment="Center" />
                    <TextBlock x:Name="GateRemaining" FontFamily="{StaticResource CondensedBold}" FontSize="128" HorizontalAlignment="Center"
                               Foreground="{ThemeResource TextBrush}" AutomationProperties.Name="Gate countdown" />
                    <TextBlock x:Name="GateLabel" Style="{StaticResource StrongText}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                    <TextBlock x:Name="GateRequired" Style="{StaticResource CondensedTitle}" HorizontalAlignment="Center" Margin="0,24,0,0" />
                    <TextBlock x:Name="GateClockLine" Style="{StaticResource MutedText}" FontSize="16" HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Before Start: the clock to the second and where a press right now would start the timer. -->
                <StackPanel x:Name="BeforeStart" Spacing="4" HorizontalAlignment="Center" Margin="0,8,0,0">
                    <TextBlock x:Name="ClockLabel" Style="{StaticResource MutedText}" HorizontalAlignment="Center" FontFamily="{StaticResource BarlowMedium}" />
                    <TextBlock x:Name="Clock" FontFamily="{StaticResource CondensedBold}" FontSize="72" HorizontalAlignment="Center"
                               Foreground="{ThemeResource TextBrush}" AutomationProperties.Name="Clock" />
                    <TextBlock x:Name="Preview" Style="{StaticResource StrongText}" HorizontalAlignment="Center" TextAlignment="Center" />
                    <TextBlock Text="Press Start when you begin your start procedure." Style="{StaticResource MutedText}" HorizontalAlignment="Center" TextAlignment="Center" />
                    <Grid ColumnSpacing="12" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Timer countdown buffer" Style="{StaticResource StrongText}" VerticalAlignment="Center" />
                                <Button Content="?" Width="26" Height="26" Padding="0" CornerRadius="13" FontFamily="{StaticResource BarlowBold}"
                                        Foreground="{ThemeResource IndigoBrush}" BorderBrush="{ThemeResource IndigoBrush}" BorderThickness="1.5" Background="Transparent"
                                        Click="BufferHelp_Click" AutomationProperties.Name="What is the countdown buffer?" />
                            </StackPanel>
                            <TextBlock x:Name="BufferText" Style="{StaticResource MutedText}" />
                        </StackPanel>
                        <Button x:Name="Minus" Grid.Column="1" Content="-" Style="{StaticResource OutlinedButton}" Click="Minus_Click" AutomationProperties.Name="One minute less" />
                        <TextBlock x:Name="BufferValue" Grid.Column="2" Style="{StaticResource StrongText}" VerticalAlignment="Center" />
                        <Button x:Name="Plus" Grid.Column="3" Content="+" Style="{StaticResource OutlinedButton}" Click="Plus_Click" AutomationProperties.Name="One minute more" />
                    </Grid>
                </StackPanel>

                <!-- After Start: a very large m:ss counting down to, then up from, the start minute. -->
                <StackPanel x:Name="Running" Spacing="4" HorizontalAlignment="Center" Margin="0,24,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="Elapsed" FontFamily="{StaticResource CondensedBold}" FontSize="128" HorizontalAlignment="Center"
                               Foreground="{ThemeResource TextBrush}" AutomationProperties.Name="Timer" />
                    <TextBlock x:Name="ElapsedLabel" Style="{StaticResource StrongText}" HorizontalAlignment="Center" />
                    <TextBlock x:Name="StartMinute" Style="{StaticResource CondensedTitle}" HorizontalAlignment="Center" Margin="0,24,0,0" />
                    <TextBlock x:Name="ClockLine" Style="{StaticResource MutedText}" FontSize="16" HorizontalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <Button x:Name="StartButton" Grid.Row="1" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch" Height="96" Click="Start_Click"
                AutomationProperties.Name="Start the timer">
            <TextBlock Text="START" FontFamily="{StaticResource CondensedBold}" FontSize="52" />
        </Button>
    </Grid>
</local:ShellPart>
