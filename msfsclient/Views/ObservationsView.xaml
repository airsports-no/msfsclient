<?xml version="1.0" encoding="utf-8"?>
<!--
    Photo observations (port of ObservationsScreen): the photos of this flight, as thumbnails or a list. The crew presses
    Mark when they see the photo's place on their track; the server scores the mark, the page only confirms it was stored.
-->
<local:ShellPart
    x:Class="msfsclient.Views.ObservationsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:msfsclient.Views"
    xmlns:helpers="using:msfsclient.Helpers"
    FontFamily="{StaticResource BarlowRegular}">

    <local:ShellPart.Resources>
        <Style x:Key="MarkButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Background" Value="{ThemeResource AmberBrush}" />
            <Setter Property="Foreground" Value="#3B2503" />
            <Setter Property="FontFamily" Value="{StaticResource BarlowSemiBold}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="MinHeight" Value="38" />
        </Style>
        <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#3B2503" />
        <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#3B2503" />

        <DataTemplate x:Key="TileTemplate" x:DataType="local:PhotoItem">
            <Border Style="{StaticResource Card}" Padding="8">
                <StackPanel Spacing="6">
                    <Button Padding="0" BorderThickness="0" Background="Transparent" Tag="{x:Bind}" Click="Open_Click" HorizontalAlignment="Stretch"
                            AutomationProperties.Name="{x:Bind Name}">
                        <Border Background="{ThemeResource OutlineBrush}" Height="180" CornerRadius="4"><Image Source="{x:Bind helpers:Ui.Image(File), FallbackValue={x:Null}}" Stretch="UniformToFill" /></Border>
                    </Button>
                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource StrongText}" />
                    <TextBlock Text="{x:Bind State, Mode=OneWay}" Style="{StaticResource SmallText}" />
                    <Button Content="{x:Bind MarkText, Mode=OneWay}" Style="{StaticResource MarkButton}" HorizontalAlignment="Stretch" IsEnabled="{x:Bind CanMark, Mode=OneWay}"
                            Tag="{x:Bind}" Click="Mark_Click" />
                    <Grid>
                        <HyperlinkButton Content="Set time" Style="{StaticResource TextButton}" Tag="{x:Bind}" Click="SetTime_Click" />
                        <HyperlinkButton Content="Cancel" HorizontalAlignment="Right" Style="{StaticResource DangerTextButton}" Visibility="{x:Bind Marked, Mode=OneWay}"
                                         Tag="{x:Bind}" Click="Cancel_Click" />
                    </Grid>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="RowTemplate" x:DataType="local:PhotoItem">
            <Border Style="{StaticResource Card}" Padding="12">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Padding="0" BorderThickness="0" Background="Transparent" Tag="{x:Bind}" Click="Open_Click" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left" VerticalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="{x:Bind Name}" Style="{StaticResource StrongText}" />
                            <TextBlock Text="{x:Bind State, Mode=OneWay}" Style="{StaticResource SmallText}" />
                        </StackPanel>
                    </Button>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                        <Button Content="{x:Bind MarkText, Mode=OneWay}" Style="{StaticResource MarkButton}" IsEnabled="{x:Bind CanMark, Mode=OneWay}" Tag="{x:Bind}" Click="Mark_Click"
                                HorizontalAlignment="Right" />
                        <StackPanel Orientation="Horizontal">
                            <HyperlinkButton Content="Set time" Style="{StaticResource TextButton}" Tag="{x:Bind}" Click="SetTime_Click" />
                            <HyperlinkButton Content="Cancel" Style="{StaticResource DangerTextButton}" Visibility="{x:Bind Marked, Mode=OneWay}" Tag="{x:Bind}" Click="Cancel_Click" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </local:ShellPart.Resources>

    <ScrollViewer>
        <StackPanel Padding="16" Spacing="12">
            <TextBlock Text="Photos" Style="{StaticResource PageTitle}" AutomationProperties.HeadingLevel="Level1" />
            <TextBlock Text="Press Mark when you see the place of a photo on your track." Style="{StaticResource MutedText}" />

            <!-- The rule, written out so that everybody understands it. -->
            <Grid Background="{ThemeResource AmberTintBrush}" Visibility="{x:Bind Vm.State.Observations.Enabled, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Background="{ThemeResource AmberBrush}" />
                <TextBlock Grid.Column="1" Margin="10" Text="{x:Bind RuleText, Mode=OneWay}" Style="{StaticResource BodyText}" />
            </Grid>

            <Grid Background="{ThemeResource AmberTintBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Background="{ThemeResource AmberBrush}" />
                <TextBlock Grid.Column="1" Margin="12" Text="{x:Bind BlockerText, Mode=OneWay}" Style="{StaticResource BodyText}" AutomationProperties.LiveSetting="Polite" />
            </Grid>

            <TextBlock Text="{x:Bind helpers:Ui.OrEmpty(Vm.State.Observations.Error), Mode=OneWay, FallbackValue=''}"
                       Visibility="{x:Bind helpers:Ui.ShowText(Vm.State.Observations.Error), Mode=OneWay, FallbackValue=Collapsed}" Style="{StaticResource ErrorText}"
                       AutomationProperties.LiveSetting="Assertive" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <ToggleButton x:Name="ThumbsTab" Content="Thumbnails" Click="Thumbs_Click" FontFamily="{StaticResource BarlowSemiBold}" />
                <ToggleButton x:Name="ListTab" Content="List" Click="List_Click" FontFamily="{StaticResource BarlowSemiBold}" />
            </StackPanel>

            <TextBlock Text="{x:Bind EmptyText, Mode=OneWay}" Visibility="{x:Bind helpers:Ui.ShowText(EmptyText), Mode=OneWay, FallbackValue=Collapsed}" Style="{StaticResource MutedText}" />
            <Button Content="Try again" Style="{StaticResource OutlinedButton}" Click="Retry_Click" Visibility="{x:Bind ShowRetry, Mode=OneWay}" />

            <ItemsRepeater x:Name="PhotoList" ItemsSource="{x:Bind Photos, Mode=OneWay}" />
        </StackPanel>
    </ScrollViewer>
</local:ShellPart>
