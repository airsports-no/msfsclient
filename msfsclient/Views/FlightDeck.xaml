<?xml version="1.0" encoding="utf-8"?>
<!--
    The bottom dock (port of ui/FlightDeck.kt): always dark ink with 24 px corners on top, the play/stop button, the tracking
    state and, when the flight uses them, a Flight / Timer / Photos switch. Shown on Home, Timer and Photos.
-->
<local:ShellPart
    x:Class="msfsclient.Views.FlightDeck"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:msfsclient.Views"
    xmlns:vm="using:msfsclient.ViewModels"
    xmlns:helpers="using:msfsclient.Helpers"
    RequestedTheme="Dark">

    <local:ShellPart.Resources>
        <Style x:Key="DeckTab" TargetType="ToggleButton">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource DockContentBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource CondensedSemiBold}" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Padding" Value="4,0" />
        </Style>
        <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#E6EAF2" />
        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#D5DBE6" />
        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#C5CCD8" />
        <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#0E1726" />
        <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#0E1726" />
        <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#0E1726" />
    </local:ShellPart.Resources>

    <Border Background="{StaticResource DockBrush}" CornerRadius="24,24,0,0" Padding="16,14,16,12">
        <StackPanel Spacing="12">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- A green circle that becomes a red stop square. Stopping asks first. -->
                <Button x:Name="TrackButton" Width="72" Height="72" CornerRadius="36" Padding="0" BorderThickness="0" VerticalAlignment="Top"
                        Click="TrackButton_Click" IsEnabled="{x:Bind TrackEnabled, Mode=OneWay}"
                        Background="{x:Bind TrackBrush, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind TrackLabel, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind TrackLabel, Mode=OneWay}">
                    <Button.Resources>
                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#33FFFFFF" />
                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#55FFFFFF" />
                        <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#662FCB84" />
                    </Button.Resources>
                    <Grid Width="28" Height="28">
                        <Polygon Points="3,0 28,14 3,28" Fill="#032B18" Visibility="{x:Bind helpers:Ui.Hide(Vm.Tracking.Running), Mode=OneWay}" />
                        <Rectangle Width="26" Height="26" Fill="#4D0218" Visibility="{x:Bind Vm.Tracking.Running, Mode=OneWay}" />
                    </Grid>
                </Button>

                <ItemsControl Grid.Column="1" ItemsSource="{x:Bind Vm.DockLines, Mode=OneWay}" VerticalAlignment="Center" IsTabStop="False"
                              AutomationProperties.LiveSetting="Polite">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:StatusLine">
                            <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" Margin="0,1"
                                       FontFamily="{x:Bind local:FlightDeck.FontFor(Tone)}" FontSize="{x:Bind local:FlightDeck.SizeFor(Tone)}"
                                       Foreground="{x:Bind local:FlightDeck.BrushFor(Tone)}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

            <!-- Training mode: the last gate crossing against its required time, in large condensed type. -->
            <Border Visibility="{x:Bind Vm.ShowGateBanner, Mode=OneWay}" Background="{StaticResource DockOverlayBrush}" CornerRadius="12" Padding="14,10">
                <Grid>
                    <TextBlock Text="Training: waiting for your first gate" FontFamily="{StaticResource BarlowSemiBold}" FontSize="16"
                               Foreground="{StaticResource DockContentBrush}" Visibility="{x:Bind GateMissing, Mode=OneWay}" />
                    <StackPanel Orientation="Horizontal" Spacing="12" Visibility="{x:Bind helpers:Ui.Hide(GateMissing), Mode=OneWay}"
                                AutomationProperties.LiveSetting="Assertive">
                        <TextBlock Text="{x:Bind GateName, Mode=OneWay}" FontFamily="{StaticResource CondensedBold}" FontSize="28"
                                   Foreground="{StaticResource DockContentBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind GateText, Mode=OneWay}" FontFamily="{StaticResource CondensedBold}" FontSize="34"
                                   Foreground="{x:Bind GateBrush, Mode=OneWay}" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- A segmented switch: the selected segment is filled, the others are plain text on ink. -->
            <Border Visibility="{x:Bind Vm.ShowDeckSwitch, Mode=OneWay}" Background="{StaticResource DockOverlayBrush}" CornerRadius="12" Padding="3">
                <Grid x:Name="Segments" ColumnSpacing="3" Height="42">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="{x:Bind TimerColumn, Mode=OneWay}" />
                        <ColumnDefinition Width="{x:Bind PhotosColumn, Mode=OneWay}" />
                    </Grid.ColumnDefinitions>
                    <ToggleButton x:Name="FlightTab" Grid.Column="0" Content="Flight" Click="Tab_Click" Tag="Flight" Style="{StaticResource DeckTab}" />
                    <ToggleButton x:Name="TimerTab" Grid.Column="1" Content="Timer" Click="Tab_Click" Tag="Timer" Style="{StaticResource DeckTab}"
                                  Visibility="{x:Bind Vm.ShowTimerTab, Mode=OneWay}" />
                    <ToggleButton x:Name="PhotosTab" Grid.Column="2" Content="{x:Bind Vm.PhotosTabLabel, Mode=OneWay}" Click="Tab_Click" Tag="Photos"
                                  Style="{StaticResource DeckTab}" Visibility="{x:Bind Vm.ShowPhotosTab, Mode=OneWay}" />
                </Grid>
            </Border>
        </StackPanel>
    </Border>

</local:ShellPart>
