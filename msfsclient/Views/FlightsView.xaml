<?xml version="1.0" encoding="utf-8"?>
<!-- My flights, upcoming and past: the same flight strips as on Home, under day headings (port of FlightsScreen). -->
<local:ShellPart
    x:Class="msfsclient.Views.FlightsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:msfsclient.Views"
    xmlns:helpers="using:msfsclient.Helpers"
    FontFamily="{StaticResource BarlowRegular}">
    <Grid Padding="16,12" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="10">
            <Grid>
                <TextBlock Text="My flights" Style="{StaticResource PageTitle}" AutomationProperties.HeadingLevel="Level1" VerticalAlignment="Center" />
                <HyperlinkButton Content="Refresh" HorizontalAlignment="Right" Style="{StaticResource TextButton}" Click="Refresh_Click" IsEnabled="{x:Bind CanRefresh, Mode=OneWay}" />
            </Grid>
            <SelectorBar x:Name="Tabs" SelectionChanged="Tabs_SelectionChanged" HorizontalAlignment="Left">
                <SelectorBarItem x:Name="UpcomingItem" Text="Upcoming" />
                <SelectorBarItem x:Name="PastItem" Text="Past" />
            </SelectorBar>
            <TextBox x:Name="SearchBox" PlaceholderText="Search contest, task, type or country" TextChanged="Search_TextChanged"
                     Visibility="{x:Bind ShowSearch, Mode=OneWay}" AutomationProperties.Name="Search past flights" />
        </StackPanel>
        <StackPanel Grid.Row="1" Spacing="4">
            <TextBlock Text="{x:Bind helpers:Ui.OrEmpty(Vm.State.Error), Mode=OneWay, FallbackValue=''}" Visibility="{x:Bind helpers:Ui.ShowText(Vm.State.Error), Mode=OneWay, FallbackValue=Collapsed}"
                       Style="{StaticResource ErrorText}" AutomationProperties.LiveSetting="Polite" />
            <TextBlock Text="{x:Bind helpers:Ui.OrEmpty(Vm.State.FlightsNotice), Mode=OneWay, FallbackValue=''}" Visibility="{x:Bind helpers:Ui.ShowText(Vm.State.FlightsNotice), Mode=OneWay, FallbackValue=Collapsed}"
                       Style="{StaticResource NoticeText}" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
        <Grid Grid.Row="2">
            <ScrollViewer x:Name="ListScroll" Visibility="{x:Bind ShowList, Mode=OneWay}" ViewChanged="ListScroll_ViewChanged">
                <ItemsControl ItemsSource="{x:Bind Days, Mode=OneWay}" IsTabStop="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:DayGroup">
                            <StackPanel Margin="0,6,0,0" Spacing="8">
                                <TextBlock Text="{x:Bind Heading}" Style="{StaticResource MutedText}" FontFamily="{StaticResource CondensedMedium}" FontSize="22"
                                           AutomationProperties.HeadingLevel="Level2" />
                                <ItemsControl ItemsSource="{x:Bind Flights}" IsTabStop="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="local:StripItem">
                                            <local:FlightStripCard Item="{x:Bind}" Margin="0,0,0,10" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <ProgressRing IsActive="{x:Bind ShowLoading, Mode=OneWay}" Visibility="{x:Bind ShowLoading, Mode=OneWay}" Width="48" Height="48"
                          HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="Loading your flights" />
            <TextBlock Text="{x:Bind NoMatchText, Mode=OneWay}" Visibility="{x:Bind ShowNoMatch, Mode=OneWay}" Style="{StaticResource MutedText}"
                       HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,24,0,0" TextWrapping="Wrap" />
            <StackPanel Visibility="{x:Bind ShowEmpty, Mode=OneWay}" Spacing="12" MaxWidth="420" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind EmptyText, Mode=OneWay}" Style="{StaticResource BodyText}" FontFamily="{StaticResource BarlowSemiBold}" FontSize="20" TextAlignment="Center" TextWrapping="Wrap" />
                <TextBlock Text="Find an event that is open for registration today, or register on the website." Style="{StaticResource MutedText}" TextAlignment="Center" TextWrapping="Wrap"
                           Visibility="{x:Bind ShowFindEvent, Mode=OneWay}" />
                <Button Content="Find an event" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Visibility="{x:Bind ShowFindEvent, Mode=OneWay}" Click="FindEvent_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</local:ShellPart>
