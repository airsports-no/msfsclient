<?xml version="1.0" encoding="utf-8"?>
<!-- The first-start tour: five short pages, skippable at any time (port of TourScreen). -->
<local:ShellPart
    x:Class="msfsclient.Views.TourView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:msfsclient.Views"
    FontFamily="{StaticResource BarlowRegular}">
    <Grid Padding="24,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <HyperlinkButton x:Name="Skip" Content="Skip" HorizontalAlignment="Right" Style="{StaticResource TextButton}" Click="Done_Click" />
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel VerticalAlignment="Center" Spacing="8">
                <TextBlock x:Name="Counter" Style="{StaticResource MutedText}" FontFamily="{StaticResource BarlowSemiBold}" FontSize="16" />
                <TextBlock x:Name="Title" Style="{StaticResource PageTitle}" FontSize="44" LineHeight="46" AutomationProperties.HeadingLevel="Level1"
                           AutomationProperties.LiveSetting="Polite" />
                <TextBlock x:Name="Body" Style="{StaticResource BodyText}" FontSize="19" LineHeight="27" Margin="0,8,0,0" />
            </StackPanel>
        </ScrollViewer>
        <StackPanel x:Name="Dots" Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" />
        <Grid Grid.Row="3" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="BackButton" Content="Back" Style="{StaticResource OutlinedButton}" Height="56" Click="Back_Click" />
            <Button x:Name="Next" Grid.Column="1" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch" Height="56" FontSize="17" Click="Next_Click" />
        </Grid>
    </Grid>
</local:ShellPart>
