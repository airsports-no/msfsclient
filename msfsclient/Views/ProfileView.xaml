<?xml version="1.0" encoding="utf-8"?>
<!-- Edit name, biography and photo; the tour, sign out and account deletion live here too (port of ProfileScreen). -->
<local:ShellPart
    x:Class="msfsclient.Views.ProfileView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:msfsclient.Views"
    xmlns:helpers="using:msfsclient.Helpers"
    FontFamily="{StaticResource BarlowRegular}">
    <ScrollViewer>
        <StackPanel Padding="16" Spacing="12">
            <TextBlock Text="Profile" Style="{StaticResource PageTitle}" AutomationProperties.HeadingLevel="Level1" />
            <StackPanel HorizontalAlignment="Center" Spacing="8">
                <PersonPicture Width="96" Height="96" Initials="{x:Bind Vm.Initials, Mode=OneWay}" ProfilePicture="{x:Bind helpers:Ui.Image(Vm.PictureUrl), Mode=OneWay}"
                               AutomationProperties.Name="Profile picture" />
                <Button Content="Change photo" Style="{StaticResource OutlinedButton}" HorizontalAlignment="Center" Click="Photo_Click"
                        IsEnabled="{x:Bind helpers:Ui.Not(Vm.State.ProfileSaving), Mode=OneWay}" />
                <TextBlock Text="{x:Bind Email, Mode=OneWay}" Style="{StaticResource MutedText}" HorizontalAlignment="Center" IsTextSelectionEnabled="True" />
                <TextBlock Text="{x:Bind TrackingId, Mode=OneWay}" Style="{StaticResource SmallText}" HorizontalAlignment="Center" IsTextSelectionEnabled="True" />
            </StackPanel>
            <TextBox x:Name="First" Header="First name" Style="{StaticResource FormBox}" TextChanged="Input_Changed" />
            <TextBox x:Name="Last" Header="Last name" Style="{StaticResource FormBox}" TextChanged="Input_Changed" />
            <TextBox x:Name="Bio" Header="About me" Style="{StaticResource FormBox}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="88" MaxHeight="160" />
            <TextBlock Text="{x:Bind helpers:Ui.OrEmpty(Vm.State.ProfileNotice), Mode=OneWay}" Visibility="{x:Bind helpers:Ui.ShowText(Vm.State.ProfileNotice), Mode=OneWay}"
                       Style="{StaticResource NoticeText}" AutomationProperties.LiveSetting="Polite" />
            <TextBlock Text="{x:Bind helpers:Ui.OrEmpty(Vm.State.Error), Mode=OneWay}" Visibility="{x:Bind helpers:Ui.ShowText(Vm.State.Error), Mode=OneWay}"
                       Style="{StaticResource ErrorText}" AutomationProperties.LiveSetting="Assertive" />
            <Button x:Name="Save" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch" Click="Save_Click" />

            <Border Height="1" Background="{ThemeResource OutlineBrush}" Margin="0,8" />
            <Button Style="{StaticResource TileButton}" Background="Transparent" BorderThickness="0" Padding="0,8" HorizontalContentAlignment="Stretch" Click="Tour_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Show the intro again" Style="{StaticResource StrongText}" />
                        <TextBlock Text="A short tour of the client" Style="{StaticResource MutedText}" />
                    </StackPanel>
                    <FontIcon Grid.Column="1" Glyph="&#xE76C;" FontSize="14" Foreground="{ThemeResource IndigoBrush}" />
                </Grid>
            </Button>
            <Border Height="1" Background="{ThemeResource OutlineBrush}" Margin="0,8" />
            <Button Content="Sign out" Style="{StaticResource OutlinedButton}" HorizontalAlignment="Stretch" Click="SignOut_Click" />
            <HyperlinkButton Content="Delete account" Style="{StaticResource DangerTextButton}" HorizontalAlignment="Center" Click="Delete_Click" />
            <local:VersionText HorizontalAlignment="Center" />
        </StackPanel>
    </ScrollViewer>
</local:ShellPart>
