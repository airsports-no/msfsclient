<?xml version="1.0" encoding="utf-8"?>
<!-- Edit name, biography and photo; the tour, sign out and account deletion live here too (port of ProfileScreen). -->
<local:ShellPart
    x:Class="msfsclient.Views.ProfileView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:msfsclient.Views"
    xmlns:helpers="using:msfsclient.Helpers"
    FontFamily="{StaticResource BarlowRegular}">
    <ScrollViewer>
        <StackPanel Padding="16" Spacing="12">
            <TextBlock Text="Profile" Style="{StaticResource PageTitle}" AutomationProperties.HeadingLevel="Level1" />
            <StackPanel HorizontalAlignment="Center" Spacing="8">
                <PersonPicture Width="96" Height="96" Initials="{x:Bind Vm.Initials, Mode=OneWay}" ProfilePicture="{x:Bind helpers:Ui.Image(Vm.PictureUrl), Mode=OneWay, FallbackValue={x:Null}}"
                               AutomationProperties.Name="Profile picture" />
                <Button Content="Change photo" Style="{StaticResource OutlinedButton}" HorizontalAlignment="Center" Click="Photo_Click"
                        IsEnabled="{x:Bind helpers:Ui.Not(Vm.State.ProfileSaving), Mode=OneWay}" />
                <TextBlock Text="{x:Bind Email, Mode=OneWay}" Style="{StaticResource MutedText}" HorizontalAlignment="Center" IsTextSelectionEnabled="True" />
                <TextBlock Text="{x:Bind TrackingId, Mode=OneWay}" Style="{StaticResource SmallText}" HorizontalAlignment="Center" IsTextSelectionEnabled="True" />
            </StackPanel>
            <TextBox x:Name="First" Header="First name" Style="{StaticResource FormBox}" TextChanged="Input_Changed" />
            <TextBox x:Name="Last" Header="Last name" Style="{StaticResource FormBox}" TextChanged="Input_Changed" />
            <TextBox x:Name="Bio" Header="About me" Style="{StaticResource FormBox}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="88" MaxHeight="160" />
            <TextBlock Text="{x:Bind helpers:Ui.OrEmpty(Vm.State.ProfileNotice), Mode=OneWay, FallbackValue=''}" Visibility="{x:Bind helpers:Ui.ShowText(Vm.State.ProfileNotice), Mode=OneWay, FallbackValue=Collapsed}"
                       Style="{StaticResource NoticeText}" AutomationProperties.LiveSetting="Polite" />
            <TextBlock Text="{x:Bind helpers:Ui.OrEmpty(Vm.State.Error), Mode=OneWay, FallbackValue=''}" Visibility="{x:Bind helpers:Ui.ShowText(Vm.State.Error), Mode=OneWay, FallbackValue=Collapsed}"
                       Style="{StaticResource ErrorText}" AutomationProperties.LiveSetting="Assertive" />
            <Button x:Name="Save" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch" Click="Save_Click" />

            <Border Height="1" Background="{ThemeResource OutlineBrush}" Margin="0,8" />
            <Button Style="{StaticResource TileButton}" Background="Transparent" BorderThickness="0" Padding="0,8" HorizontalContentAlignment="Stretch" Click="Tour_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Show the intro again" Style="{StaticResource StrongText}" />
                        <TextBlock Text="A short tour of the client" Style="{StaticResource MutedText}" />
                    </StackPanel>
                    <FontIcon Grid.Column="1" Glyph="&#xE76C;" FontSize="14" Foreground="{ThemeResource IndigoBrush}" />
                </Grid>
            </Button>
            <Border Height="1" Background="{ThemeResource OutlineBrush}" Margin="0,8" />
            <TextBlock Text="In the simulator" Style="{StaticResource CondensedTitle}" AutomationProperties.HeadingLevel="Level2" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Messages in the simulator" Style="{StaticResource StrongText}" />
                    <TextBlock Text="Tracking started and stopped, reception, gate results in training mode, the start minute and new announcements, printed at the top of the MSFS screen."
                               Style="{StaticResource MutedText}" />
                </StackPanel>
                <ToggleSwitch x:Name="SimMessages" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" Toggled="SimMessages_Toggled"
                              AutomationProperties.Name="Messages in the simulator" />
            </Grid>
            <StackPanel Spacing="2">
                <TextBlock Text="Flight display" Style="{StaticResource StrongText}" />
                <TextBlock Text="{x:Bind HudText, Mode=OneWay}" Style="{StaticResource MutedText}" IsTextSelectionEnabled="True" />
                <HyperlinkButton Content="Open in the browser" Style="{StaticResource TextButton}" Padding="0,6" Click="Hud_Click"
                                 Visibility="{x:Bind helpers:Ui.ShowText(Vm.HudUrl), Mode=OneWay, FallbackValue=Collapsed}" />
            </StackPanel>
            <StackPanel Spacing="2">
                <TextBlock Text="Toolbar panel in MSFS" Style="{StaticResource StrongText}" />
                <TextBlock x:Name="PanelText" Style="{StaticResource MutedText}" />
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                    <Button x:Name="PanelInstall" Style="{StaticResource OutlinedButton}" Click="PanelInstall_Click" />
                    <HyperlinkButton x:Name="PanelRemove" Content="Remove" Style="{StaticResource DangerTextButton}" Click="PanelRemove_Click" />
                </StackPanel>
            </StackPanel>
            <Border Height="1" Background="{ThemeResource OutlineBrush}" Margin="0,8" />
            <Button Content="Sign out" Style="{StaticResource OutlinedButton}" HorizontalAlignment="Stretch" Click="SignOut_Click" />
            <HyperlinkButton Content="Delete account" Style="{StaticResource DangerTextButton}" HorizontalAlignment="Center" Click="Delete_Click" />
            <local:VersionText HorizontalAlignment="Center" />
        </StackPanel>
    </ScrollViewer>
</local:ShellPart>
