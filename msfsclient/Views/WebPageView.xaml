<?xml version="1.0" encoding="utf-8"?>
<!-- The embedded web app (Register today, live map, results), signed in with the pilot's token in a header. -->
<local:ShellPart
    x:Class="msfsclient.Views.WebPageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:msfsclient.Views"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">
    <Grid>
        <controls:WebView2 x:Name="Web" />
        <ProgressRing x:Name="Spinner" IsActive="True" Width="40" Height="40" AutomationProperties.Name="Loading the page" />
        <TextBlock x:Name="Problem" Visibility="Collapsed" Style="{StaticResource ErrorText}" Margin="24" VerticalAlignment="Center" TextAlignment="Center" />
    </Grid>
</local:ShellPart>
