<?xml version="1.0" encoding="utf-8"?>
<!-- Everything that can make tracking fail, on one page, checked live while it is open (port of PreflightScreen). -->
<local:ShellPart
    x:Class="msfsclient.Views.PreflightView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:msfsclient.Views"
    xmlns:helpers="using:msfsclient.Helpers"
    FontFamily="{StaticResource BarlowRegular}">
    <ScrollViewer>
        <StackPanel Padding="16" Spacing="12">
            <TextBlock Text="Pre-flight" Style="{StaticResource PageTitle}" AutomationProperties.HeadingLevel="Level1" />
            <TextBlock Text="{x:Bind Vm.PreflightSummary, Mode=OneWay}" Style="{StaticResource MutedText}" FontFamily="{StaticResource BarlowSemiBold}" FontSize="16"
                       AutomationProperties.LiveSetting="Polite" />
            <ItemsControl ItemsSource="{x:Bind Checks, Mode=OneWay}" IsTabStop="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:CheckItem">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="14" Height="14" Margin="0,8,0,0" VerticalAlignment="Top" Fill="{x:Bind helpers:Ui.Brush(DotBrushKey)}"
                                         AutomationProperties.Name="{x:Bind StatusName}" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="{x:Bind Title}" Style="{StaticResource CondensedTitle}" />
                                    <TextBlock Text="{x:Bind Detail}" Style="{StaticResource MutedText}" />
                                    <HyperlinkButton Content="{x:Bind ActionText}" Visibility="{x:Bind HasAction}" Style="{StaticResource TextButton}" Padding="0,6"
                                                     Tag="{x:Bind}" Click="Action_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</local:ShellPart>
