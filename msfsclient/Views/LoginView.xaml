<?xml version="1.0" encoding="utf-8"?>
<local:ShellPart
    x:Class="msfsclient.Views.LoginView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:msfsclient.Views"
    xmlns:helpers="using:msfsclient.Helpers"
    FontFamily="{StaticResource BarlowRegular}">
    <ScrollViewer>
        <StackPanel Padding="24" Spacing="10" VerticalAlignment="Center">
            <TextBlock Text="Airsports" Style="{StaticResource PageTitle}" FontSize="40" Margin="0,24,0,8" />
            <TextBox x:Name="Email" Header="Email" InputScope="EmailSmtpAddress" Style="{StaticResource FormBox}" TextChanged="Email_Changed"
                     IsSpellCheckEnabled="False" />
            <PasswordBox x:Name="Password" Header="Password" PasswordChanged="Password_Changed" KeyDown="Password_KeyDown" />
            <Button x:Name="Submit" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch" Margin="0,6,0,0" Click="Submit_Click" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <HyperlinkButton x:Name="ModeButton" Style="{StaticResource TextButton}" Click="Mode_Click" />
                <HyperlinkButton x:Name="ResetButton" Content="Forgot password?" Style="{StaticResource TextButton}" Click="Reset_Click" />
            </StackPanel>

            <!-- Google / Apple, through the website in the browser: the same account as on the website and in the apps. -->
            <Grid ColumnSpacing="10" Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Rectangle Height="1" Fill="{ThemeResource OutlineBrush}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="or" Style="{StaticResource MutedText}" />
                <Rectangle Grid.Column="2" Height="1" Fill="{ThemeResource OutlineBrush}" VerticalAlignment="Center" />
            </Grid>
            <StackPanel x:Name="ProviderButtons" Spacing="8">
                <Button x:Name="GoogleButton" Style="{StaticResource OutlinedButton}" HorizontalAlignment="Stretch" Click="Google_Click"
                        AutomationProperties.Name="Continue with Google">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Viewbox Width="18" Height="18">
                            <Canvas Width="48" Height="48">
                                <Path Fill="#EA4335" Data="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z" />
                                <Path Fill="#4285F4" Data="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z" />
                                <Path Fill="#FBBC05" Data="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z" />
                                <Path Fill="#34A853" Data="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="Continue with Google" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="AppleButton" Style="{StaticResource OutlinedButton}" HorizontalAlignment="Stretch" Click="Apple_Click"
                        AutomationProperties.Name="Continue with Apple">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Viewbox Width="18" Height="18">
                            <Canvas Width="384" Height="512">
                                <Path Fill="{ThemeResource TextBrush}" Data="M318.7 268.7c-.2-36.7 16.4-64.4 50-84.8-18.8-26.9-47.2-41.7-84.7-44.6-35.5-2.8-74.3 20.7-88.5 20.7-15 0-49.4-19.7-76.4-19.7C63.3 141.2 4 184.8 4 273.5q0 39.3 14.4 81.2c12.8 36.7 59 126.7 107.2 125.2 25.2-.6 43-17.9 75.8-17.9 31.8 0 48.3 17.9 76.4 17.9 48.6-.7 90.4-82.5 102.6-119.3-65.2-30.7-61.7-90-61.7-91.9zm-56.6-164.2c27.3-32.4 24.8-61.9 24-72.5-24.1 1.4-52 16.4-67.9 34.9-17.5 19.8-27.8 44.3-25.6 71.9 26.1 2 49.9-11.4 69.5-34.3z" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="Continue with Apple" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <TextBlock Style="{StaticResource SmallText}" TextWrapping="Wrap"
                           Text="Google and Apple sign you in in your browser, with the same account as on the website and in the Air Sports app. Apple's &quot;Hide My Email&quot; gives a new account, separate from one with your real email address: choose &quot;Share My Email&quot; to keep it." />
            </StackPanel>
            <StackPanel x:Name="BrowserWait" Visibility="Collapsed" Spacing="4">
                <TextBlock x:Name="BrowserWaitText" Style="{StaticResource BodyText}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                <HyperlinkButton Content="Cancel" Style="{StaticResource TextButton}" Click="CancelProvider_Click" />
            </StackPanel>
            <TextBlock Text="{x:Bind helpers:Ui.OrEmpty(Vm.State.Notice), Mode=OneWay, FallbackValue=''}" Visibility="{x:Bind helpers:Ui.ShowText(Vm.State.Notice), Mode=OneWay, FallbackValue=Collapsed}"
                       Style="{StaticResource BodyText}" AutomationProperties.LiveSetting="Polite" />
            <TextBlock Text="{x:Bind helpers:Ui.OrEmpty(Vm.State.Error), Mode=OneWay, FallbackValue=''}" Visibility="{x:Bind helpers:Ui.ShowText(Vm.State.Error), Mode=OneWay, FallbackValue=Collapsed}"
                       Style="{StaticResource ErrorText}" AutomationProperties.LiveSetting="Assertive" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                <TextBlock Text="By using Airsports you accept the " Style="{StaticResource SmallText}" VerticalAlignment="Center" />
                <HyperlinkButton Content="terms &amp; privacy policy" Padding="2,0" FontSize="13" Click="Terms_Click" />
            </StackPanel>
            <local:VersionText HorizontalAlignment="Center" />
        </StackPanel>
    </ScrollViewer>
</local:ShellPart>
